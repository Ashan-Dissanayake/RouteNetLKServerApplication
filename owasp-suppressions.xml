        <!-- Apache Tomcat (tomcat-embed-* 10.1.55) - Triage & VEX Suppressions    -->
        <!-- ===================================================================== -->

        <suppress>
            <notes><![CDATA[
        Triage: Not Affected. Single-host Spring Boot deployment using default HTTP/1.1 without multi-host TLS strict SNI or HTTP/2.
        ]]></notes>
            <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-.*@.*$</packageUrl>
            <cve>CVE-2026-65637</cve>
            <cve>CVE-2026-68763</cve>
        </suppress>

        <suppress>
            <notes><![CDATA[
        Triage: Not Affected. Application uses stateless Spring Security JWT authentication; Tomcat DIGEST, FORM, and DataSourceRealm authenticators are not used.
        ]]></notes>
            <packageUrl regex="true">^pkg:maven/org\.apache\.tomcat\.embed/tomcat-embed-.*@.*$</packageUrl>
            <cve>CVE-2026-65905</cve>
