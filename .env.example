# ============================================================
# RouteNetLK Server Application - Environment Configuration Template
# ============================================================
# Copy this file to '.env' and fill in your local values.
# NEVER commit the '.env' file to version control.
# ============================================================

# Spring Profile ('dev' for local, 'prod' for AWS EC2, 'test' for tests)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/routenetlk
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
# Base64 encoded secret key (min 256-bit for HS256)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=86400000

# Default In-Memory Admin Account
ADMIN_USER_NAME=routeNetLKAdmin
ADMIN_USER_PASSWORD=your_admin_password_here

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Email Service (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here
